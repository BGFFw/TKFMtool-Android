# 统一换行，避免 Windows 检出把脚本改成 CRLF
* text=auto

*.kt      text eol=lf
*.kts     text eol=lf
*.java    text eol=lf
*.xml     text eol=lf
*.js      text eol=lf
*.tsv     text eol=lf
*.md      text eol=lf
*.pro     text eol=lf
*.properties text eol=lf
gradlew   text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf

*.jar     binary
*.apk     binary
*.aab     binary
*.png     binary
*.jpg     binary
*.keystore binary
*.jks     binary
